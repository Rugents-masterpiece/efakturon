@page "/companies"
@using Efakturon.Domain.Entities
@inject IDbContextFactory<EfakturonDbContext> DbFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@layout MainLayout

<PageTitle>Firmy</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Evidencia firiem</MudText>

<MudDialogButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">Pridať firmu</MudButton>
</MudDialogButton>

<MudTable Items="companies" Hover="true" Striped="true" Dense="true">
    <HeaderContent>
        <MudTh>Názov</MudTh>
        <MudTh>IČO</MudTh>
        <MudTh>DIČ</MudTh>
        <MudTh>IČ DPH</MudTh>
        <MudTh>Typ</MudTh>
        <MudTh>Mesto</MudTh>
        <MudTh>IBAN</MudTh>
        <MudTh>Akcie</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.ICO</MudTd>
        <MudTd>@context.DIC</MudTd>
        <MudTd>@context.DICDPH</MudTd>
        <MudTd>@GetStatusLabel(context.Type)</MudTd>
        <MudTd>@context.City</MudTd>
        <MudTd>@context.IBAN</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" 
                OnClick="() => OpenEditDialog(context)" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                OnClick="() => Delete(context.Id)" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<Company> companies = new();
    private bool createDialogVisible = false;
    private bool editDialogVisible = false;
    private Company? editingCompany;
    private Company newCompany = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        companies = await db.Companies.ToListAsync();
    }

    private void OpenCreateDialog()
    {
        newCompany = new Company();
        createDialogVisible = true;
    }

    private void OpenEditDialog(Company company)
    {
        editingCompany = company;
        editDialogVisible = true;
    }

    private async Task SaveNew()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        db.Companies.Add(newCompany);
        await db.SaveChangesAsync();
        createDialogVisible = false;
        await LoadData();
        Snackbar.Add("Firma pridaná", Severity.Success);
    }

    private async Task SaveEdit()
    {
        if (editingCompany == null) return;
        using var db = await DbFactory.CreateDbContextAsync();
        db.Entry(editingCompany).State = EntityState.Modified;
        await db.SaveChangesAsync();
        editDialogVisible = false;
        await LoadData();
        Snackbar.Add("Firma upravená", Severity.Success);
    }

    private async Task Delete(Guid id)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var item = await db.Companies.FindAsync(id);
        if (item != null)
        {
            db.Companies.Remove(item);
            await db.SaveChangesAsync();
            await LoadData();
            Snackbar.Add("Firma vymazaná", Severity.Success);
        }
    }

    private string GetStatusLabel(Company.CompanyType type) => type switch
    {
        Company.CompanyType.OwnCompany => "Vlastná firma",
        Company.CompanyType.Customer => "Odberateľ",
        Company.CompanyType.Supplier => "Dodávateľ",
        _ => type.ToString()
    };
}
